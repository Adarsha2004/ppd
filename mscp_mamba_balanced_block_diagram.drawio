></mxCell><mxCell id="e23" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ad2" target="Yp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ss2dT" value="SS2D internals (d_model 240, expand 2 → d_inner 480, d_state N = 16, dt_rank 30)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#EA580C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="185" width="1500" height="28" as="geometry"/></mxCell><mxCell id="s_in" value="x&lt;br&gt;[B,H,W,240]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="10" y="290" width="110" height="70" as="geometry"/></mxCell><mxCell id="s_ip" value="in_proj&lt;br&gt;Linear 240 → 960" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="150" y="295" width="120" height="60" as="geometry"/></mxCell><mxCell id="s_sp" value="Split&lt;br&gt;x_val | z&lt;br&gt;(480 each)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=10;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="300" y="295" width="100" height="60" as="geometry"/></mxCell><mxCell id="s_dw" value="Depthwise 3×3&lt;br&gt;conv, 480 groups" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="430" y="295" width="130" height="60" as="geometry"/></mxCell><mxCell id="s_si" value="SiLU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="590" y="295" width="80" height="60" as="geometry"/></mxCell><mxCell id="s_cs" value="&lt;b&gt;Cross-scan&lt;/b&gt;&lt;br&gt;4 ordered sequences&lt;br&gt;[B,480,L], L = H·W" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="150" height="70" as="geometry"/></mxCell><mxCell id="d0" value="rows →" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="890" y="238" width="110" height="36" as="geometry"/></mxCell><mxCell id="d1" value="rows ←" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="890" y="284" width="110" height="36" as="geometry"/></mxCell><mxCell id="d2" value="cols ↓" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="890" y="330" width="110" height="36" as="geometry"/></mxCell><mxCell id="d3" value="cols ↑" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="890" y="376" width="110" height="36" as="geometry"/></mxCell><mxCell id="s_sc" value="&lt;b&gt;1-D selective scan&lt;/b&gt; (per direction)&lt;br&gt;x_proj → (Δ, B, C)&lt;br&gt;dt_proj + softplus(Δ)&lt;br&gt;hᵢ = exp(ΔᵢA)·hᵢ₋₁ + Δᵢ·uᵢ·Bᵢ&lt;br&gt;yᵢ = Cᵢ·hᵢ + D·uᵢ&lt;br&gt;A = −exp(A_log) · fp32" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=10;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1060" y="238" width="200" height="174" as="geometry"/></mxCell><mxCell id="s_av" value="Un-scan&lt;br&gt;+ average&lt;br&gt;4 directions" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=10;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1300" y="295" width="100" height="60" as="geometry"/></mxCell><mxCell id="s_gt" value="×" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=16;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="310" width="30" height="30" as="geometry"/></mxCell><mxCell id="s_op" value="out_proj&lt;br&gt;Linear 480 → 240" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1500" y="295" width="110" height="60" as="geometry"/></mxCell><mxCell id="s_out" value="output&lt;br&gt;[B,H,W,240]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1650" y="290" width="110" height="70" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_in" target="s_ip"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_ip" target="s_sp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="x_val" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_sp" target="s_dw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e43" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_dw" target="s_si"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_si" target="s_cs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cs" target="d0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e46" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="s_sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cs" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.37;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="s_sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cs" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.63;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="s_sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cs" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="s_sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_sc" target="s_av"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_av" target="s_gt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e55" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_gt" target="s_op"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e56" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_op" target="s_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e57" value="z → SiLU(z) gate" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0D9488;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_sp" target="s_gt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="450"/><mxPoint x="1455" y="450"/></Array></mxGeometry></mxCell><mxCell id="n4" value="&lt;b&gt;Selective-scan dispatch:&lt;/b&gt; official CUDA kernel from mamba-ssm on sm80+ GPUs (A100, L4); on T4/P100 a pure-PyTorch chunked two-pass scan (chunk 64, verified against a naive reference) is used. All scans run in fp32 outside AMP because Δ discretisation is fp16-fragile; SS2D scans are gradient-checkpointed during training on the fallback path to avoid OOM.&lt;br&gt;&lt;b&gt;Why SS2D here:&lt;/b&gt; the CNN encoder and MSCP only see local/dilated neighbourhoods; four-direction scanning gives every pixel of the 60×80 bottleneck global context along both axes at linear cost, which targets the temporal-free “object becomes background” errors the paper lists as a limitation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="10" y="480" width="1700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg5" name="5 - Decoder and fusion layer"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Decoder blocks and Fusion Layer:  fused = ( GlobalMaxPool( 1×1conv(low) ) · dec ) + dec" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="5" width="1400" height="30" as="geometry"/></mxCell><mxCell id="dg" value="Decoder Block (×3)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#DCFCE7;fillOpacity=25;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#16A34A;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="40" width="1010" height="150" as="geometry"/></mxCell><mxCell id="dbi" value="input&lt;br&gt;(240 or 64 ch)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="100" height="70" as="geometry"/></mxCell><mxCell id="dbc" value="3×3 conv, 64 filters&lt;br&gt;pad 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="170" y="90" width="150" height="70" as="geometry"/></mxCell><mxCell id="dbn" value="Contrast Norm&lt;br&gt;(64)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="120" height="70" as="geometry"/></mxCell><mxCell id="dbr" value="ReLU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="100" height="70" as="geometry"/></mxCell><mxCell id="dbo" value="64 ch" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="120" height="70" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dbi" target="dbc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dbc" target="dbn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dbn" target="dbr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dbr" target="dbo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dbt" value="Block 1: 240→64 @60×80 · Block 2: 64 @120×160 · Block 3: 64 @240×320" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="210" height="70" as="geometry"/></mxCell><mxCell id="fg" value="Fusion Layer (×2, shares low_full = o₁ from encoder Block 1)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#CCFBF1;fillOpacity=25;strokeColor=#0D9488;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0D9488;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="230" width="1510" height="280" as="geometry"/></mxCell><mxCell id="lo" value="&lt;b&gt;low_full&lt;/b&gt;&lt;br&gt;64×240×320" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="lc" value="1×1 conv 64" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="200" y="300" width="130" height="70" as="geometry"/></mxCell><mxCell id="gm" value="Global MaxPool&lt;br&gt;→ [B,64,1,1]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="bi" value="Bilinear expand&lt;br&gt;to dec size" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="mu" value="×" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=16;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="320" width="30" height="30" as="geometry"/></mxCell><mxCell id="ad" value="+" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=16;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="30" height="30" as="geometry"/></mxCell><mxCell id="dec" value="dec_out&lt;br&gt;64×h×w" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="150" height="60" as="geometry"/></mxCell><mxCell id="fo" value="&lt;b&gt;fused&lt;/b&gt;&lt;br&gt;64×h×w" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="150" height="70" as="geometry"/></mxCell><mxCell id="nx" value="Upsample ×2 (bilinear)&lt;br&gt;then next Decoder Block" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1290" y="300" width="200" height="70" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lo" target="lc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lc" target="gm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gm" target="bi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bi" target="mu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ad" target="fo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fo" target="nx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mu" target="ad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16A34A;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="mu"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="795" y="380"/></Array></mxGeometry></mxCell><mxCell id="e30" value="residual" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#DC2626;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="ad"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="460"/></Array></mxGeometry></mxCell><mxCell id="fn" value="FusionLayer 1 runs at 60×80 and FusionLayer 2 at 120×160. The pooled low-level vector acts as channel attention on the decoded features; the “+ dec” term keeps the original decoder signal. The head (1×1 conv → 1 channel) outputs raw logits; sigmoid and the 0.9 threshold are applied in loss/inference." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="10" y="530" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg6" name="6 - Training and evaluation pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Balanced-sampling training pipeline (CDnet 2014 thermal), evaluation and explainability" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#111827;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="5" width="1500" height="30" as="geometry"/></mxCell><mxCell id="g1" value="Data" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#FEF9C3;fillOpacity=25;strokeColor=#CA8A04;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#CA8A04;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="40" width="1680" height="170" as="geometry"/></mxCell><mxCell id="g2" value="Training loop" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#FEE2E2;fillOpacity=25;strokeColor=#DC2626;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#DC2626;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="230" width="1680" height="200" as="geometry"/></mxCell><mxCell id="g3" value="Evaluation, explainability, outputs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#EDE9FE;fillOpacity=25;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#7C3AED;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="10" y="450" width="1680" height="190" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;CDnet 2014 thermal&lt;/b&gt;&lt;br&gt;5 scenes: corridor, diningRoom,&lt;br&gt;lakeSide, library, park" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Balanced sampler&lt;/b&gt;&lt;br&gt;200 frames = 40 per scene&lt;br&gt;seeded per-scene shuffle" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="305" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Val split&lt;/b&gt;&lt;br&gt;tail 10% of every scene&lt;br&gt;(90 / 10 split)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;GT decoding&lt;/b&gt;&lt;br&gt;255 → fg · 0, 85 → bg&lt;br&gt;170 → ignore · ROI mask" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="855" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;Preprocess&lt;/b&gt;&lt;br&gt;resize 240×320, scale 0–1&lt;br&gt;batch size 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1130" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;Sample returns&lt;/b&gt;&lt;br&gt;x, label, valid mask,&lt;br&gt;inverse-frequency weight" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="1405" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t1" value="&lt;b&gt;MSCPNet&lt;/b&gt;&lt;br&gt;CNN + VSS hybrid&lt;br&gt;8.73 M params" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="220" height="90" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Weighted BCE&lt;/b&gt;&lt;br&gt;logits, ROI-masked&lt;br&gt;class weights, fp32" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#111827;shadow=1;" vertex="1" parent="1"><mxGeometry x="305" y="275" width="220" height="90" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;AdamW&lt;/b&gt;&lt;br&gt;lr 5e-4 · wd 0.05&lt;br&gt;no decay on norms / A_log" style="rounded=1